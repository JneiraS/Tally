t": null, "author": null, "contributor": null}, {"id": "readme_mutation_use_cases", "label": "Mutation Use Cases (Create/Complete/Update DailyActivity, Create ScopeMonitoring)", "file_type": "concept", "source_file": "README.md", "source_location": "## Use cases (couche application)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_create_scopemonitoring_atomicity", "label": "Atomic ScopeMonitoring Creation", "file_type": "rationale", "source_file": "README.md", "source_location": "Use cases table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CreateScopeMonitoringUseCase creates several scopes (uuid4 ids) atomically: a duplicate name or any invalid line means nothing is persisted."}, {"id": "readme_query_use_cases", "label": "Query Use Cases (ListScopes, GetScope, GetDailyActivity, ListAuditEvents)", "file_type": "concept", "source_file": "README.md", "source_location": "Lectures (application/queries/)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_csv_import_adapter", "label": "CSV Import Inbound Adapter", "file_type": "concept", "source_file": "README.md", "source_location": "## Import CSV", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_http_api_adapter", "label": "FastAPI HTTP Inbound Adapter", "file_type": "concept", "source_file": "README.md", "source_location": "## API HTTP (FastAPI)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rest_routes_table", "label": "REST Routes and Status Codes Table", "file_type": "concept", "source_file": "README.md", "source_location": "Routes table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_domain_error_http_mapping", "label": "Domain Error to HTTP Status Mapping", "file_type": "concept", "source_file": "README.md", "source_location": "Exception handlers (adapters/inbound/api/errors.py)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_project_authentication", "label": "Project Authentication with Quadrigramme Restriction", "file_type": "concept", "source_file": "README.md", "source_location": "### Authentification par projet", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_quadrigramme_bootstrap_exemption", "label": "Quadrigramme Bootstrap Exemption", "file_type": "rationale", "source_file": "README.md", "source_location": "Restriction du quadrigramme", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once a project owns at least one scope the login quadrigramme must match an official_main or official_backup, but while a project has no scope any quadrigramme is accepted so the very first scope can still be created."}, {"id": "readme_project_settings_working_days", "label": "Per-Project Working Days Settings", "file_type": "concept", "source_file": "README.md", "source_location": "GET/PUT /project/settings", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_audit_trail", "label": "Audit Trail (best-effort mutation journal)", "file_type": "rationale", "source_file": "README.md", "source_location": "### Journal d'audit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every mutation is traced with actor, action, scope, day and a field-by-field before/after diff, but writes are best-effort: an audit failure must not fail the business request, and no-op changes are not logged."}, {"id": "readme_postgres_persistence", "label": "PostgreSQL Persistence Adapter", "file_type": "concept", "source_file": "README.md", "source_location": "## Persistance", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_scope_monitorings_index", "label": "scope_monitorings(project_id, name) Index", "file_type": "rationale", "source_file": "README.md", "source_location": "## Persistance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The composite index on (project_id, name) exists to cover the per-project filtering plus name ordering used by scope listing queries, created with the schema at startup since no migration tool is used."}, {"id": "readme_same_origin_nginx_proxy", "label": "Same-Origin nginx Reverse Proxy (no CORS)", "file_type": "rationale", "source_file": "README.md", "source_location": "## Docker", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nginx serves the React SPA and proxies /scope-monitorings to the api, keeping everything same-origin so no CORS configuration is required."}, {"id": "readme_makefile_targets", "label": "Makefile Targets (db-up, docker-up, db-shell, test-db)", "file_type": "concept", "source_file": "README.md", "source_location": "## Docker", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_protab", "target": "readme_scope_monitoring_aggregate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "## Domain model", "weight": 1.0}, {"source": "readme_scope_monitoring_aggregate", "target": "readme_daily_activity_entity", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "daily_activities: dict[date, DailyActivity]", "weight": 1.0}, {"source": "readme_aggregate_owns_daily_activities", "target": "readme_scope_monitoring_aggregate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "### D\u00e9cisions de mod\u00e9lisation", "weight": 1.0}, {"source": "readme_day_not_a_class_decision", "target": "readme_daily_activity_entity