{"nodes": [{"id": "agents_hexagonal_architecture", "label": "Hexagonal Architecture (Ports and Adapters)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a72 Core Architectural Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The architecture exists to protect the application core from external technical concerns; code quality and architectural integrity take priority over implementation speed."}, {"id": "agents_dependency_rule", "label": "Dependency Rule (Adapters \u2192 Ports \u2192 Application \u2192 Domain)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a74 Dependency Rule", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependencies must always point toward the application core so the domain stays independent of infrastructure; imports of flask/sqlalchemy/requests in domain code are explicitly forbidden."}, {"id": "agents_domain_layer", "label": "Domain Layer", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a75 Domain Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_application_layer_use_cases", "label": "Application Layer / Use Cases", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a76 Application Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_ports_contracts", "label": "Ports (Inbound and Outbound Contracts)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a77 Ports", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_adapters", "label": "Adapters (Inbound / Outbound)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a78 Adapters", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_test_driven_development", "label": "Test-Driven Development (RED/GREEN/REFACTOR)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a79 Test-Driven Development", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TDD is mandatory for new behavior: write a failing test first, implement the minimum to pass without speculative functionality, then refactor while keeping tests green."}, {"id": "agents_testing_strategy", "label": "Testing Strategy (Test Pyramid)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a710 Testing Strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_solid_principles", "label": "SOLID Principles", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a711 SOLID Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_dependency_injection", "label": "Dependency Injection and Composition Root", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a712 Dependency Injection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependencies must be injected rather than instantiated inside business logic, and concrete wiring happens only in a Composition Root at the outermost layer."}, {"id": "agents_framework_isolation", "label": "Framework Isolation", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a713 Framework Isolation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frameworks and infrastructure libraries are implementation details kept at the outer layers so a framework can be replaced without rewriting the domain."}, {"id": "agents_type_safety", "label": "Type Safety and Protocol-based Interfaces", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a714 Type Safety", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_error_handling", "label": "Domain Error Handling and Adapter Translation", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a715 Error Handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business errors are expressed as domain exceptions; infrastructure exceptions must not leak into the domain and are translated at the adapter boundary."}, {"id": "agents_configuration_and_secrets", "label": "Configuration and Secrets Management", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a716 Configuration and Secrets", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configuration stays separate from business logic; passwords, API keys, tokens, credentials and environment-specific URLs must never be hard-coded, and secrets must never be committed."}, {"id": "agents_avoid_premature_abstraction", "label": "Avoid Premature Abstraction", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a718 Avoid Premature Abstraction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The architecture exists to protect business logic, not to maximize the number of interfaces or classes: prefer Simple + Testable + Decoupled over Complex + Over-engineered."}, {"id": "agents_development_workflow", "label": "Development Workflow (9 Steps)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "\u00a719 Development Workflow", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_documentation_synchronization", "label": "Documentation Synchronization Requirement", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a721, \u00a722, \u00a723", "source_url": null, "captured_at": null, "author": null, "contributor": nu