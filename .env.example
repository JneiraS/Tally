# Adresse d'écoute du serveur (défaut: 0.0.0.0)
PROTAB_HOST=0.0.0.0

# Port du serveur (défaut: 8000)
PROTAB_PORT=8000

# Attribut Secure du cookie de session. Défaut: 0 (développement HTTP local).
# ⚠️ En production, TLS doit être terminé par le reverse proxy : mettre à 1.
PROTAB_COOKIE_SECURE=0

# URL de connexion PostgreSQL (DSN psycopg), obligatoire pour démarrer l'API.
DATABASE_URL=postgresql://protab:protab@localhost:5432/protab

# Projet initial créé automatiquement au premier démarrage de l'API.
# ⚠️ PROTAB_DEFAULT_PROJECT_PASSWORD et PROTAB_DEFAULT_PROJECT_ADMIN_CODE sont
# OBLIGATOIRES au premier démarrage, car le projet doit être créé : sans elles,
# l'API refuse de démarrer (RuntimeError) plutôt que de créer un projet
# protégé par un mot de passe devinable, ou un projet sans administrateur.
#
# L'administrateur est le quadrigramme autorisé à se connecter même s'il n'est
# déclaré dans aucun périmètre. C'est la seule garantie qu'un projet ayant des
# périmètres reste ouvrable : dès le premier périmètre, tout autre quadrigramme
# est refusé. Sans administrateur nommé, la personne qui crée ce premier
# périmètre perd son accès.
#
# Une fois le projet créé, les variables ne sont plus lues : supprimer ces
# lignes avant de redémarrer une installation déjà initialisée est sans effet.
PROTAB_DEFAULT_PROJECT_CODE=protab
PROTAB_DEFAULT_PROJECT_NAME=Projet principal
PROTAB_DEFAULT_PROJECT_PASSWORD=change-me-before-first-start
PROTAB_DEFAULT_PROJECT_ADMIN_CODE=MYAD

# Projet à créer ensuite avec `uv run protab-project <code> <nom> [--admin <quadrigramme>]`.

# URL de la base PostgreSQL dédiée aux tests d'intégration de l'adapter.
# Les tests sont ignorés (skip) si cette variable est absente.
PROTAB_TEST_DATABASE_URL=postgresql://protab:protab@localhost:5432/protab_test
