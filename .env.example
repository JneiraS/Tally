# Adresse d'écoute du serveur (défaut: 0.0.0.0)
PROTAB_HOST=0.0.0.0

# Port du serveur (défaut: 8000)
PROTAB_PORT=8000

# URL de connexion PostgreSQL (SQLAlchemy style DSN).
# Si absente ou vide, le backend utilise le repository en mémoire (défaut démo/tests).
DATABASE_URL=postgresql://protab:protab@localhost:5432/protab

# URL de la base PostgreSQL dédiée aux tests d'intégration de l'adapter.
# Les tests sont ignorés (skip) si cette variable est absente.
PROTAB_TEST_DATABASE_URL=postgresql://protab:protab@localhost:5432/protab_test
